# A minimal dockerfile for the bazel-rules-hdl-flow.yml environment

# The riscv toolchain is needed for power analysis flow
FROM debian:trixie-slim AS riscv-toolchain-build
# RISCV-GCC dependencies
RUN apt update && apt install -y --no-install-recommends autoconf automake autotools-dev curl \
    python3 python3-pip python3-tomli libmpc-dev libmpfr-dev libgmp-dev gawk build-essential \
    bison flex texinfo gperf libtool patchutils bc zlib1g-dev libexpat-dev meson ninja-build \
    git cmake libglib2.0-dev expect device-tree-compiler libslirp-dev libzstd-dev libncurses-dev
# Clone and build RISC-V toolchain
RUN git clone https://github.com/riscv-collab/riscv-gnu-toolchain.git riscv
# This is a workaround for unstable upstream dependency servers
RUN cd riscv && git checkout 317ee3d && sed -i \
  -e 's#url = https://sourceware.org/git/binutils-gdb.git#url = git://sourceware.org/git/binutils-gdb.git#' \
  -e 's#url = https://sourceware.org/git/glibc.git#url = git://sourceware.org/git/glibc.git#' \
  -e 's#url = https://gcc.gnu.org/git/gcc.git#url = git://gcc.gnu.org/git/gcc.git#' \
  -e 's#url = https://sourceware.org/git/newlib-cygwin.git#url = git://sourceware.org/git/newlib-cygwin.git#' \
  .gitmodules
RUN cd riscv && ./configure --prefix=/opt/riscv --enable-multilib && \
  make -j$(nproc) && \
  cd .. && \
  rm -rf riscv


FROM debian:trixie-slim

COPY --from=riscv-toolchain-build /opt/riscv /opt/riscv
ENV PATH="$PATH:/opt/riscv/bin"

# openroad-qt runtime dependencies
RUN apt update && apt install -y --no-install-recommends libx11-6 libx11-xcb1 \
    libsm6 libice6 libxcb1 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
    libxcb-randr0 libxcb-render0 libxcb-render-util0 libxcb-shape0 libxcb-shm0 libxcb-sync1 \
    libxcb-util1 libxcb-xfixes0 libxcb-xkb1 libdbus-1-3 libfontconfig1 libxkbcommon0 libxkbcommon-x11-0

RUN apt install -y --no-install-recommends git ca-certificates python3 make meson libmpc-dev libatomic1 libxml2 libc6-dev

RUN ln -s /usr/lib/x86_64-linux-gnu/libatomic.so.1 /usr/lib/x86_64-linux-gnu/libatomic.so
