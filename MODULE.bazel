module(
    name = "cores_veer_el2",
    version = "0.0.1",
    repo_name = "cores_veer_el2",
    bazel_compatibility = [">=8.5.0"],
)

bazel_dep(name = "abc", version = "0.62-yosyshq")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", repo_name = "com_google_googletest")
bazel_dep(name = "readline", version = "8.3")
bazel_dep(name = "libffi", version = "3.4.7.bcr.3")
bazel_dep(name = "rules_bison", version = "0.4")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_flex", version = "0.4")
bazel_dep(name = "rules_foreign_cc", version = "0.14.0")
bazel_dep(name = "rules_m4", version = "0.3.bcr.1")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "zlib", version = "1.3.1.bcr.7")
bazel_dep(name = "bzip2", version = "1.0.8.bcr.3")
bazel_dep(name = "gperf", version = "3.1.bcr.2")
bazel_dep(name = "tcl_lang", version = "8.6.16.bcr.1")

# Buildifier
bazel_dep(name = "rules_perl", version = "1.1.2")
cpan = use_extension("@rules_perl//perl/cpan:extensions.bzl", "cpan")
cpan.install(
    name = "cpan",
    lock = "//configs:cpanfile.snapshot.lock.json",
)
use_repo(
    cpan,
    "cpan",
)
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "protobuf", version = "36.1.bcr.1")
# Python toolchain
bazel_dep(name = "rules_python", version = "2.4.2")

rules_hdl_pdks = use_extension("@rules_hdl//dependency_support:pdks_extension.bzl", "pdks_extension")
use_repo(
    rules_hdl_pdks,
    "com_google_skywater_pdk",
    "com_google_skywater_pdk_sky130_fd_sc_hd",
    "com_google_skywater_pdk_sky130_fd_sc_hdll",
    "com_google_skywater_pdk_sky130_fd_sc_hs",
    "com_google_skywater_pdk_sky130_fd_sc_hvl",
    "com_google_skywater_pdk_sky130_fd_sc_lp",
    "com_google_skywater_pdk_sky130_fd_sc_ls",
    "com_google_skywater_pdk_sky130_fd_sc_ms",
    "org_theopenroadproject_asap7_pdk_r1p7",
    "org_theopenroadproject_asap7sc6t_26",
    "org_theopenroadproject_asap7sc7p5t_27",
    "org_theopenroadproject_asap7sc7p5t_28",
)

bazel_dep(name = "rules_hdl", version = "0.0.5")
bazel_dep(name = "openroad", version = "0.0.0", repo_name = "org_theopenroadproject")
bazel_dep(name = "rules_7zip", version = "0.0.1")

git_override(
    module_name = "rules_hdl",
    # FIXME: currently points to latest commit in 107479-bazel-rules-hdl-el2
    # TODO: rebase 107479-bazel-rules-hdl-el2 on develop
    commit = "49514520a93283d2f6b3582d3a0f70bfa4cdcc7a",
    remote = "https://github.com/antmicro/bazel_rules_hdl.git",
)

# Root-only overrides from rules_hdl's MODULE.bazel
git_override(
    module_name = "rules_7zip",
    commit = "03a10b5796eac0aed122cf52064ed15785610857",
    remote = "https://github.com/zaucy/rules_7zip.git",
)

# 7zip extension
extension_setup_7zip = use_extension("@rules_7zip//:extension_setup_7zip.bzl", "extension_setup_7zip")
use_repo(extension_setup_7zip, "7zip")

# Need git_override b/c of submodules
git_override(
    module_name = "openroad",
    commit = "51c9638fb0b005e5d60d7216970110543621125c",
    init_submodules = True,
    remote = "https://github.com/The-OpenROAD-Project/OpenROAD.git",
)

# These are from openroad and don't propagate.
git_override(
    module_name = "qt-bazel",
    commit = "90cfbab79df93960c5493f8a75df6199fb80fe26",
    remote = "https://github.com/The-OpenROAD-Project/qt_bazel_prebuilts",
)
git_override(
    module_name = "z3",
    commit = "ac9156f97cb44e56472e1c841f7a2beb1e976b24",
    remote = "https://github.com/Z3Prover/z3.git",
)

single_version_override(
    module_name = "rules_bison",
    patch_strip = 1,
    patches = ["//dependency_support/rules_bison:include_cstdlib.patch"],
)

# rules_hdl registers it as dev_dependency only
bazel_dep(name = "toolchains_llvm", version = "1.5.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(llvm_version = "19.1.7")
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

# Load tools
tools = use_extension("//dependency_support:tools_extension.bzl", "tools_extension")
use_repo(tools, "at_clifford_yosys")
use_repo(tools, "at_clifford_yosys_data")
use_repo(tools, "com_icarus_iverilog")
use_repo(tools, "net_lz4")
