index de7f6ef715..d4cfe67bab 100644
--- a/src/dpl/include/dpl/Opendp.h
+++ b/src/dpl/include/dpl/Opendp.h
@@ -233,6 +233,7 @@ class Opendp

   std::string printBgBox(const boost::geometry::model::box<bgPoint>& queryBox);
   void diamondDPL();
+  void checkWindowSupply();
   DbuPt nearestPt(const Node* cell, const DbuRect& rect) const;
   int distToRect(const Node* cell, const odb::Rect& rect) const;
   static bool checkOverlap(const odb::Rect& cell, const odb::Rect& box);
diff --git a/src/dpl/src/Opendp.cpp b/src/dpl/src/Opendp.cpp
index 4b9cff1153..e949a2cc49 100644
--- a/src/dpl/src/Opendp.cpp
+++ b/src/dpl/src/Opendp.cpp
@@ -258,6 +258,10 @@ void Opendp::detailedPlacement(const int max_displacement_x,
       groupInitPixels2();
       groupInitPixels();
     }
+    // The negotiation's windows extend up to the same displacement cap
+    // the diamond search has; a placement no window can legalize is
+    // refused here too, before the iterations are spent.
+    checkWindowSupply();
     if (!quiet_) {
       logger_->info(DPL, 1102, "Legalizing using negotiation legalizer.");
     }
diff --git a/src/dpl/src/Place.cpp b/src/dpl/src/Place.cpp
index eddb1dfe91..4e907d2a26 100644
--- a/src/dpl/src/Place.cpp
+++ b/src/dpl/src/Place.cpp
@@ -83,6 +83,8 @@ void Opendp::diamondDPL()
     placeGroups();
   }

+  checkWindowSupply();
+
   if (debug_observer_) {
     logger_->report("Pause before detail placement.");
     debug_observer_->redrawAndPause();
@@ -96,6 +98,167 @@ void Opendp::diamondDPL()
   }
 }

