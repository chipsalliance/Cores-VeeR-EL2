# SPDX-License-Identifier: Apache-2.0

OFILES = crt0.o icache_infection.o printf.o
TEST_CFLAGS = -g -O3 -falign-functions=16

# Define RV_ICACHE_ADDR_XOR for test software when hardware address-XOR infection is configured
ifneq (,$(findstring icache_addr_xor=1,$(CONF_PARAMS)))
    TEST_CFLAGS += -DRV_ICACHE_ADDR_XOR=1
else ifneq (,$(wildcard $(BUILD_DIR)/common_defines.vh))
    ifneq (,$(shell grep -w "RV_ICACHE_ADDR_XOR" $(BUILD_DIR)/common_defines.vh 2>/dev/null))
        TEST_CFLAGS += -DRV_ICACHE_ADDR_XOR=1
    endif
endif
