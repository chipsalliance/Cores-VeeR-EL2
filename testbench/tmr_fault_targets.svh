
`define FAULT_TARGET(ID, SIG_PATH)                                  \
ID: begin                                                           \
  rand_bit = $urandom_range($bits(SIG_PATH)-1, 0);                  \
  SIG_PATH = SIG_PATH ^ ($bits(SIG_PATH))'(1) << rand_bit;          \
  $display("[%0t] TMR SEU %s[%0d]", $time, `"SIG_PATH`", rand_bit); \
end
